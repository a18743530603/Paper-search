# DeepSeek RAG configuration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_THINKING=true
DEEPSEEK_TIMEOUT=120
RESEARCH_QUERY_ROUTING_ENABLED=true
RESEARCH_PRF_ENABLED=true
RESEARCH_CANDIDATE_POOL_SIZE=50
RESEARCH_FINAL_SEED_COUNT=5
RESEARCH_RERANKER_ENABLED=true
RESEARCH_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RESEARCH_MMR_ENABLED=true
RESEARCH_MMR_LAMBDA=0.5
RESEARCH_PARENT_EXPANSION_ENABLED=true

# Volcano Ark Seed Embedding configuration
# Recommended current model: Seed1.6 Doubao-embedding-vision (text is supported).
SEED_API_KEY=
SEED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEED_EMBEDDING_MODEL=doubao-embedding-vision-251215
# auto detects embedding-vision; use multimodal for an ep-... endpoint of this model.
SEED_EMBEDDING_API_MODE=auto
SEED_TIMEOUT=120

# MinerU cloud Precision Extract API (default PDF parser)
# Create the token in MinerU API management. Keep it only in .env.
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_REQUEST_TIMEOUT=120
MINERU_PARSE_TIMEOUT=1200
MINERU_POLL_INTERVAL=5

# Optional application settings
MAX_RESULTS=20
ENABLE_AGENT=false

# Business Database (production default: MySQL; no automatic SQLite fallback)
# Use BUSINESS_DB_BACKEND=sqlite only for explicit local compatibility tests.
BUSINESS_DB_BACKEND=mysql
BUSINESS_DB_HOST=127.0.0.1
BUSINESS_DB_PORT=3306
BUSINESS_DB_NAME=paper_hunter
BUSINESS_DB_USER=
BUSINESS_DB_PASSWORD=
BUSINESS_DB_CONNECT_TIMEOUT=10
BUSINESS_DB_READ_TIMEOUT=30
BUSINESS_DB_WRITE_TIMEOUT=30

# LangGraph checkpoints remain in their independent SQLite database at
# downloads/langgraph_checkpoints.db; they are not part of the Business Database.
